{
  "name": "@contagio/server",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/smoke.test.mjs",
    "watch": "tsc -b --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@contagio/engine": "*",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.6.0"
  }
}